<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="shell_dark">#111111</color>
    <color name="shell_light">#F7F5F0</color>
    <color name="icon_background">#141414</color>

    <style name="Theme.SelfOS" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/shell_dark</item>
        <item name="android:colorAccent">#E0E0E0</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
    <style name="Theme.SelfOS.Light" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/shell_light</item>
        <item name="android:colorAccent">#333333</item>
    </style>
    <style name="Theme.SelfOS.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/shell_dark</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.SelfOS</item>
    </style>
</resources>
