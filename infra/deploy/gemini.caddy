# Imported inside the SELF OS site block.
@geminiPrivate path /ai/gemini/* /v1/ai-gemini/authorize /.well-known/oauth-authorization-server /.well-known/oauth-protected-resource*
log_skip @geminiPrivate
handle /v1/ai-gemini/authorize {
	header >Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
	header >Referrer-Policy "same-origin"
	reverse_proxy 127.0.0.1:8792
}
handle /ai/gemini/* {
	reverse_proxy 127.0.0.1:8792 {
		header_up -Cookie
	}
}
handle /.well-known/oauth-authorization-server {
	reverse_proxy 127.0.0.1:8792 {
		header_up -Cookie
	}
}
handle /.well-known/oauth-protected-resource* {
	reverse_proxy 127.0.0.1:8792 {
		header_up -Cookie
	}
}
