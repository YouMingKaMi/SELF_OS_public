<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Daily copy of the newest verified server backup into iCloud. Installed with infra/deploy/install-backup-agent.sh,
     which fills in REPO and HOME. Runs at 13:00 (the server backs up around 12:20) and once at login;
     a run missed while the Mac sleeps happens on wake. -->
<plist version="1.0"><dict>
  <key>Label</key><string>org.personalcouncil.next.backup</string>
  <key>ProgramArguments</key><array><string>/bin/sh</string><string>REPO/infra/deploy/pull-backup.sh</string></array>
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>13</integer><key>Minute</key><integer>0</integer></dict>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>HOME/Library/Logs/CouncilNext/backup.log</string>
  <key>StandardErrorPath</key><string>HOME/Library/Logs/CouncilNext/backup.log</string>
</dict></plist>
