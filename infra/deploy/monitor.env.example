# Optional overrides for /etc/council-next/monitor.env
COUNCIL_MONITOR_DB=council_next
COUNCIL_MONITOR_API_PORT=8790
COUNCIL_MONITOR_API_MAX_MS=1500
COUNCIL_MONITOR_BACKUP_MAX_HOURS=36
COUNCIL_MONITOR_DISK_MAX_PERCENT=85
COUNCIL_MONITOR_LOCK_WAIT_LIMIT=2
COUNCIL_MONITOR_BREACH_SAMPLES=2
COUNCIL_MONITOR_ALERT_COOLDOWN_MINUTES=60
# Set paths to directories on each dedicated disk if volumes differ from the default.
COUNCIL_MONITOR_DATA_DISK=/var/lib/postgresql
COUNCIL_MONITOR_BACKUP_DISK=/var/backups
