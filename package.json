{
  "name": "self-os",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "test": "node --test \"modules/*/tests/*.test.ts\" \"tests/unit/*.test.ts\"",
    "verify": "node scripts/check.mjs && npm run contracts:check && npm run typecheck && npm test",
    "typecheck": "tsc",
    "api": "node services/api/server.ts",
    "test:integration": "node --test \"tests/integration/*.test.ts\"",
    "web": "vite --config apps/web/vite.config.ts",
    "build:web": "vite build --config apps/web/vite.config.ts",
    "dev": "npm run build:web && node scripts/dev.mjs",
    "contracts:generate": "node scripts/generate-contracts.ts",
    "contracts:check": "node scripts/generate-contracts.ts --check && node scripts/generate-migration.ts --check",
    "backup:local": "node scripts/backup-local.mjs --verify",
    "db:migration": "node scripts/generate-migration.ts",
    "seed": "node scripts/seed-system.ts && node scripts/prepare-demo.ts"
  },
  "dependencies": {
    "fastify": "^5.12.8",
    "idb": "^8.0.4",
    "lunar-typescript": "^1.8.7",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vite": "^8.3.6"
  },
  "license": "MIT",
  "private": true
}
