{
  "openapi": "3.1.1",
  "info": {
    "title": "SELF OS — sync API",
    "version": "1.0.0",
    "description": "Generated from packages/contracts/schema.ts; do not edit. One write path, one read path. v1 only gains optional fields. Development identity only: device pairing is not implemented."
  },
  "paths": {
    "/v1/commands": {
      "post": {
        "operationId": "submitCommand",
        "summary": "Create, replace or delete one entity. Idempotent per device and operationId.",
        "security": [
          {
            "devBearer": []
          }
        ],
        "parameters": [
          {
            "name": "x-device-id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Command"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Accepted, or a conflict carrying the server copy. A conflict is a normal outcome, not an error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Receipt"
                }
              }
            }
          },
          "400": {
            "description": "The payload broke a schema or business rule; `error` is CODE or CODE:field.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong credential.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "OPERATION_REUSED or NOT_FOUND.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/changes": {
      "get": {
        "operationId": "listChanges",
        "summary": "Entities changed after the cursor, each once at its latest state, in revision order.",
        "security": [
          {
            "devBearer": []
          }
        ],
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string",
              "pattern": "^[0-9]{1,18}$"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500
            }
          }
        ],
        "responses": {
          "200": {
            "description": "One page. Apply it and store nextCursor atomically.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Changes"
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong credential.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
